    label: Receiver bandwidth
    label0: ''
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    labels: '["fBW=160kHz  fIF=250kHz","fBW=200kHz  fIF=250kHz","fBW=250kHz  fIF=250kHz","fBW=320kHz  fIF=500kHz","fBW=400kHz  fIF=500kHz","fBW=500kHz  fIF=500kHz","fBW=630kHz  fIF=1000kHz","fBW=800kHz  fIF=1000kHz","fBW=1000kHz
      fIF=1000kHz","fBW=1250kHz fIF=2000kHz","fBW=1600kHz fIF=2000kHz","fBW=2000kHz
      fIF=2000kHz"]'
    num_opts: '0'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
