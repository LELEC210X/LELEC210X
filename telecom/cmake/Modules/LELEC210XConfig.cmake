INCLUDE(FindPkgConfig)
PKG_CHECK_MODULES(PC_LELEC210X LELEC210X)

FIND_PATH(
    LELEC210X_INCLUDE_DIRS
    NAMES LELEC210X/api.h
    HINTS $ENV{LELEC210X_DIR}/include
        ${PC_LELEC210X_INCLUDEDIR}
    PATHS ${CMAKE_INSTALL_PREFIX}/include
          /usr/local/include
          /usr/include
)

FIND_LIBRARY(
    LELEC210X_LIBRARIES
    NAMES gnuradio-LELEC210X
    HINTS $ENV{LELEC210X_DIR}/lib
        ${PC_LELEC210X_LIBDIR}
    PATHS ${CMAKE_INSTALL_PREFIX}/lib
          ${CMAKE_INSTALL_PREFIX}/lib64
          /usr/local/lib
          /usr/local/lib64
          /usr/lib
          /usr/lib64
          )

include("${CMAKE_CURRENT_LIST_DIR}/LELEC210XTarget.cmake")

INCLUDE(FindPackageHandleStandardArgs)
FIND_PACKAGE_HANDLE_STANDARD_ARGS(LELEC210X DEFAULT_MSG LELEC210X_LIBRARIES LELEC210X_INCLUDE_DIRS)
MARK_AS_ADVANCED(LELEC210X_LIBRARIES LELEC210X_INCLUDE_DIRS)
